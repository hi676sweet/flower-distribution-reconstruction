{
  "name": "stocklane",
  "version": "1.0.0",
  "private": true,
  "description": "An original inventory and order fulfillment portfolio application.",
  "license": "MIT",
  "engines": { "node": ">=24.4.0 <25" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch api/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.api.json && tsc -p tsconfig.web.json && vite build",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.cjs",
    "check": "npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
